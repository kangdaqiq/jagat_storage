# Konfigurasi Storage Server
PORT=8085
HOST=0.0.0.0

# Base URL publik (opsional). Jika dikosongkan, server akan otomatis mendeteksi dari Host request.
# Untuk Android Emulator gunakan: http://10.0.2.2:8085
# Untuk Android Device fisik via WiFi LAN, gunakan IP laptop Anda: http://192.168.1.xxx:8085
BASE_URL=

# Folder penyimpanan file
UPLOAD_DIR=./uploads

# Maksimal ukuran upload dalam Megabytes (MB)
MAX_UPLOAD_SIZE_MB=100

# Kunci API untuk keamanan dari aplikasi Android
API_KEY=android-storage-secret-key
ADMIN_API_KEY=android-storage-secret-key

# Batas kuota penyimpanan default untuk user baru dalam Megabytes (MB). 1000 = 1 GB
DEFAULT_USER_QUOTA_MB=1000

# Aturan Autentikasi
REQUIRE_AUTH_FOR_UPLOAD=true
REQUIRE_AUTH_FOR_DOWNLOAD=false

